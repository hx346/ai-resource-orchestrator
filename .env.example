# ============================================================
# AI Resource Orchestrator - Environment Variables Template
# Copy to .env (docker compose) or export in your shell.
# NEVER commit real keys. See SECURITY.md.
# ============================================================

# ---------- LLM Provider (any OpenAI-compatible API) ----------
# Examples:
#   OpenAI:    https://api.openai.com
#   DeepSeek:  https://api.deepseek.com
#   vLLM:      http://your-host:8000
AI_MODE=off
# live: AI_CHAT_PROVIDER=openai + a real key. demo: explicit template, no model calls.
AI_CHAT_PROVIDER=none
AI_BASE_URL=https://api.openai.com
AI_API_KEY=
AI_MODEL=gpt-4o-mini

# Required on first startup. Used only to INSERT admin; never resets an existing password.
ADMIN_PASSWORD=
APP_PORT=8080

# ---------- PostgreSQL ----------
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=ai_resource_orchestrator
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# ---------- Outbound notifications (Phase 5, optional) ----------
# off (default) disables; live requires NOTIFY_WEBHOOK_URL.
# Provider payload formats: generic (default) / feishu / dingtalk / wecom group-bot webhooks.
NOTIFY_MODE=off
NOTIFY_PROVIDER=generic
# Example: https://open.feishu.cn/open-apis/bot/v2/hook/xxxx (tokens in the query string are masked in logs)
NOTIFY_WEBHOOK_URL=

# ---------- Event-driven auto replanning (Phase 4, optional) ----------
# off (default): manual replanning only. detect: push REPLAN_SUGGESTED notices on conflicts.
# auto: additionally draft a replacement plan automatically (human confirmation still required).
REPLAN_AUTO_TRIGGER=off
REPLAN_COOLDOWN_MINUTES=30

# ---------- Semantic skill search (Phase 3, optional; requires pgvector) ----------
# Use a pgvector-enabled PostgreSQL image (pgvector/pgvector:pg16) before enabling.
# local: deterministic in-process hash (no external calls). live: OpenAI-compatible /v1/embeddings.
SKILL_SEMANTIC_ENABLED=false
SKILL_SEMANTIC_MODE=local
SKILL_SEMANTIC_DIM=256
EMBEDDING_MODEL=text-embedding-3-small
# AI_EMBEDDING_PROVIDER=openai  # set together with AI_API_KEY when SKILL_SEMANTIC_MODE=live

# ---------- External project sync (Phase 5, optional; one-way import) ----------
# SYNC_JIRA_ENABLED=true
# SYNC_JIRA_BASE_URL=https://jira.example.com
# SYNC_JIRA_USERNAME=you@example.com
# SYNC_JIRA_API_TOKEN=...
# SYNC_GITLAB_ENABLED=true
# SYNC_GITLAB_BASE_URL=https://gitlab.example.com
# SYNC_GITLAB_TOKEN=glpat-...
# SYNC_GITHUB_ENABLED=true
# SYNC_GITHUB_BASE_URL=https://api.github.com
# SYNC_GITHUB_TOKEN=ghp-...
# SYNC_ZENTAO_ENABLED=true
# SYNC_ZENTAO_BASE_URL=https://zentao.example.com
# SYNC_ZENTAO_TOKEN=...
# SYNC_ZENTAO_PATH_PROJECTS=/api.php/v1/projects
# SYNC_ZENTAO_PATH_TASKS=/api.php/v1/projects/{id}/tasks

# ---------- Docker build (optional) ----------
# Maven mirror used INSIDE the image build (empty = Maven Central).
# Set this when the build container cannot reach repo.maven.apache.org reliably,
# e.g. MAVEN_MIRROR_URL=https://repo.huaweicloud.com/repository/maven
MAVEN_MIRROR_URL=
